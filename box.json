{
    "name":"jojo",
    "version":"1.0.0",
    "author":"You",
    "location":"forgeboxStorage",
    "slug":"jojo",
    "createPackageDirectory":false,
    "type":"mvc",
    "language":"boxlang",
    "keywords":"boxlang",
    "shortDescription":"A ColdBox application using BoxLang",
    "ignore":[
        "changelog.md",
        ".github/ISSUE_TEMPLATE",
        ".github/workflows/*",
        ".github/CONTRIBUTING.md",
        ".github/FUNDING.YML",
        ".github/PULL_REQUEST_TEMPLATE.md"
    ],
    "dependencies":{
        "coldbox":"8.1.0"
    },
    "devDependencies":{
        "testbox":"7.0.0",
        "route-visualizer":"2.2.0",
        "commandbox-boxlang":"1.22.0",
        "testbox-cli":"1.9.0"
    },
    "installPathConventions":{
        "modules":"lib/modules"
    },
    "installPaths":{
        "coldbox":"lib/coldbox/",
        "testbox":"lib/testbox/",
        "route-visualizer":"lib/modules/route-visualizer/"
    },
    "scripts":{
        "format":"!boxlang format --source app/,tests/specs/,*.bx",
        "format:check":"!boxlang format --check --source app/,tests/specs/,*.bx",
        "docker:build":"!docker build --pull -t jojo:local .",
        "docker:run":"!docker run --rm -it -p 8080:8080 --env-file .env jojo:local",
        "docker:bash":"!docker run --rm -it --entrypoint /bin/bash jojo:local",
        "docker:stack":"!docker compose --env-file deploy/.env.production -f deploy/compose.production.yml ${1}"
    },
    "testbox":{
        "runner":"/tests/runner.bxm"
    }
}
