# Copy to deploy/.env.production and keep the real file out of Git.
# Prefer an immutable semantic-version tag or image digest for production.
JOJO_IMAGE=ghcr.io/jhocali/aiseries:1.0.0

# Bind to loopback when a reverse proxy on the same host terminates TLS.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

APP_TIMEZONE=America/Chicago
LOG_LEVEL=INFO
MAX_MEMORY=512m
MIN_MEMORY=256m
SESSION_TIMEOUT=0,0,30,0

MONGODB_DATASOURCE=jomongo
MONGODB_DATABASE=jomongo
MONGODB_URI_SECRET_FILE=./secrets/mongodb-uri
