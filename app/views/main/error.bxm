<bx:script>
errorTitle = structKeyExists( prc, "errorTitle" ) ? prc.errorTitle : "Request unavailable.";
errorMessage = structKeyExists( prc, "errorMessage" )
	? prc.errorMessage
	: "Please try again. If the problem continues, contact your administrator.";
</bx:script>

<bx:output>
<style>
	:root {
		color-scheme: dark;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-height: 100vh;
		margin: 0;
		display: grid;
		place-items: center;
		background:
			radial-gradient(circle at 20% 10%, rgba(143, 225, 215, 0.12), transparent 35rem),
			##05090c;
		color: ##f7f0e6;
	}

	main {
		width: min(34rem, calc(100% - 3rem));
		padding: 2.5rem;
		border: 1px solid rgba(143, 225, 215, 0.24);
		border-radius: 1rem;
		background: rgba(9, 13, 16, 0.94);
		box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35);
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.75rem, 5vw, 2.4rem);
	}

	p {
		margin: 0 0 1.5rem;
		color: ##bcc9cf;
		line-height: 1.65;
	}

	a {
		color: ##8fe1d7;
		font-weight: 700;
	}

	a:focus-visible {
		outline: 3px solid ##f1917d;
		outline-offset: 4px;
	}
</style>

<main>
	<h1>#encodeForHTML( errorTitle )#</h1>
	<p>#encodeForHTML( errorMessage )#</p>
	<a href="/">Return to Jojo</a>
</main>
</bx:output>
